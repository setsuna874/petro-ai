    "workflow": {
      "label": "案例流程",
      "title": "构建分段环境 → 离散状态动作 → 学习动作价值 → 独立策略回放 → 收益和约束核验",
      "lead": [
        "演示内的“02 案例流程”提供五个可点击步骤，每步解释输入、输出、计算要点与失败条件。"
      ],
      "steps": [
        {
          "name": "构建分段环境",
          "role": "数据",
          "do": "三段产液按共享处理能力比例限流；开得越大，含水推进越快。",
          "effect": "三段含水 / 开度 → 动态产液模型",
          "trap": "分段干扰只有共享处理能力，未求解渗流方程。"
        },
        {
          "name": "离散状态动作",
          "role": "特征",
          "do": "每段可全开或半开，组合为8动作；观测含水离散成27状态。",
          "effect": "3档含水 × 3段 → 27状态 / 8动作",
          "trap": "不可观测压力和前一动作使问题仅近似马尔可夫。"
        },
        {
          "name": "学习动作价值",
          "role": "学习",
          "do": "450回合ε贪心探索，Q←Q+α(r+γmaxQ′−Q)，绘制实际回合收益。",
          "effect": "环境奖励 / 新状态 → Q表与回合收益",
          "trap": "训练奖励改动需重训；不得编造奖励上升曲线。"
        },
        {
          "name": "独立策略回放",
          "role": "预测",
          "do": "冻结Q表，30步比较学习、全开、含水阈值规则，三个方案相同初始环境。",
          "effect": "新初始含水状态 → 油水与开度时序",
          "trap": "测试不再更新Q，不能用已知未来结果选动作。"
        },
        {
          "name": "收益和约束核验",
          "role": "质控",
          "do": "同时报油量、水量、累计奖励和切换次数，回放选中步分段开度。",
          "effect": "三策略累计量 → 累计油 / 水 / 奖励",
          "trap": "回报提高可能牺牲油量；不保证每个测试条件学习都获胜。"
        }
      ],
