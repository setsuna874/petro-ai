    "workflow": {
      "label": "案例流程",
      "title": "明确设计窗口 → 生成标定样本 → 训练效率代理 → 约束搜索 → 回算与对照",
      "lead": [
        "演示内的“02 案例流程”提供五个可点击步骤，每步解释输入、输出、计算要点与失败条件。"
      ],
      "steps": [
        {
          "name": "明确设计窗口",
          "role": "数据",
          "do": "把孔隙/破裂压力转换为同深度等效密度，设置上下安全裕度。",
          "effect": "压力下限 / 上限 → 约束范围",
          "trap": "本例使用均匀等效窗口，真实工程必须逐深度校核。"
        },
        {
          "name": "生成标定样本",
          "role": "特征",
          "do": "在给定范围采样，由教学响应面生成带噪效率标签。",
          "effect": "密度 / 排量 / 流变 → 360个效率标签",
          "trap": "模型只是逼近该模拟关系，不能宣称实测训练。"
        },
        {
          "name": "训练效率代理",
          "role": "学习",
          "do": "用线性、平方和交互特征拟合，100点独立测试报告RMSE。",
          "effect": "参数二阶特征 → 岭回归系数",
          "trap": "选择结果有代理误差，需回算参考模型。"
        },
        {
          "name": "约束搜索",
          "role": "预测",
          "do": "剔除ECD越窗组合，按代理效率从高到低排序。",
          "effect": "参数网格 / 压力窗口 → 可行方案与优选",
          "trap": "无可行方案时明确返回不可行，不能偷偷放宽窗口。"
        },
        {
          "name": "回算与对照",
          "role": "质控",
          "do": "用同一参考响应面复算两种方案，显示效率增益和可行性。",
          "effect": "优选 / 固定经验方案 → 效率与压力裕度",
          "trap": "高效率不能抵消压力约束违反。"
        }
      ],
